# ─────────────────────────────────────────────────────────────
#  paw-techstore API — variáveis de ambiente
#  Copia este ficheiro para `.env` e preenche os valores.
#  REGRA: nenhuma destas variáveis está hardcoded no código.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# ── Base de dados (escolhe UMA) ──────────────────────────────
# (1) Atlas (cloud) — usado na ENTREGA, funciona em qualquer máquina sem instalar nada:
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/paw-techstore?retryWrites=true&w=majority
#
# (2) Docker / local — usado em DESENVOLVIMENTO (Mongo em container):
MONGODB_URI=mongodb://127.0.0.1:27017/paw-techstore

# ── Autenticação (Fase 1+) ───────────────────────────────────
JWT_SECRET=muda-este-segredo-em-producao
JWT_EXPIRES_IN=1h

# ── CORS — origem do cliente Angular ─────────────────────────
CLIENT_URL=http://localhost:4200

# ── Email (opcional) ─────────────────────────────────────────
# Sem SMTP configurado, usa-se uma conta de teste Ethereal (preview nos logs).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=paw-techstore <no-reply@paw-techstore.pt>
