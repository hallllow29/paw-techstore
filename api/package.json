{
  "name": "paw-techstore-api",
  "version": "0.1.0",
  "description": "API REST do paw-techstore — plataforma e-commerce (PAW)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed/seed.js",
    "seed:images": "node src/seed/seed-images.js",
    "seed:specs": "node src/seed/seed-specs.js",
    "test": "cross-env NODE_ENV=test node --test --test-reporter=spec",
    "test:coverage": "cross-env NODE_ENV=test c8 --reporter=lcov --reporter=text node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.3.0",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "nodemailer": "^9.0.1",
    "socket.io": "^4.8.3",
    "stripe": "^22.2.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "c8": "^10.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^15.12.0",
    "mongodb-memory-server": "^10.1.2",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0"
  }
}
