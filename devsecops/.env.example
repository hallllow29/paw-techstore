# ─────────────────────────────────────────────────────────────
#  Configuração da orquestração DevSecOps local
#  Copia para devsecops/.env e preenche os tokens.
#  (este ficheiro NÃO contém segredos reais — o .env real é ignorado pelo git)
# ─────────────────────────────────────────────────────────────

# ── SonarQube (local) ──
SONAR_URL=http://localhost:9000
# Gera em SonarQube → My Account → Security → Generate Token
SONAR_TOKEN=

# ── DefectDojo (local) ──
DEFECTDOJO_URL=http://localhost:8080
# Gera em DefectDojo → perfil → API v2 Key
DEFECTDOJO_TOKEN=
# ID do Engagement onde os relatórios são importados (cria-o uma vez no DefectDojo)
DEFECTDOJO_ENGAGEMENT_ID=1
